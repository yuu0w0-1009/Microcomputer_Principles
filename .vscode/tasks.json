{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ASEM-51: 單檔組譯 (Ctrl+Shift+B)",
            "type": "shell",
            "command": "make",
            "args": [
                "single",
                "CURRENT_FILE=\"${file}\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "asem51",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*?)\\s+$(\\d+),(\\d+)\\s+$\\s*:\\s*(error|warning|fatal)\\s*:\\s*(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ],
            "detail": "對目前開啟的 .a51 / .A51 檔呼叫 make single，輸出 hex/lst 到原始檔同目錄。"
        }
    ]
}