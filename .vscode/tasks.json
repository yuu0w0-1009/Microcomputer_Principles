{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build 8051 Assembly",
            "type": "process",
            "command": "${workspaceFolder}/asem5113/asemw.exe",
            "args": [
                "${fileBasename}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}