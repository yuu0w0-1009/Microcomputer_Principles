       MCS-51 Family Macro Assembler   A S E M - 5 1   V 1.3
       =====================================================



	Source File:	08.a51
	Object File:	08.hex
	List File:	08.lst



 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 程式名稱: UART 接收字元 (0~F) 並顯示於七段顯示器
    3:				; 硬體配置:
    4:				;   - MCU: AT89S51 (石英震盪器 11.0592 MHz)
    5:				;   - UART: P3.0(RXD), P3.1(TXD), 波特率 9600 bps, 8N1
    6:				;   - 七段顯示器: 5611BS (共陽極接 VCC，P2.0~P2.7 輸出 0 點亮)
    7:				; ==============================================================================
    8:
    9:		N      0000	        ORG  0000H
   10:	  0000	02 00 30	        LJMP        MAIN
   11:
   12:		N      0030	        ORG  0030H
   13:	  0030			MAIN:
   14:				        ; --------------------------------------------------------------------------
   15:				        ; 1. 初始化 UART (Timer 1 Mode 2, 9600 bps, 8-bit, 無同位, 1 停止位)
   16:				        ; --------------------------------------------------------------------------
   17:	  0030	75 89 20	        MOV  TMOD, #20H          ; 設定 Timer 1 為 Mode 2 (8 位元自動重載)
   18:	  0033	75 8D FD	        MOV  TH1,  #0FDH        ; 11.0592MHz 下 9600 bps 之重載值
   19:	  0036	75 8B FD	        MOV  TL1,  #0FDH
   20:	  0039	75 87 00	        MOV  PCON, #00H          ; SMOD = 0 (波特率不倍增)
   21:	  003C	75 98 50	        MOV  SCON, #50H          ; UART Mode 1 (8-bit), REN = 1 (允許接收)
   22:	  003F	D2 8E		        SETB        TR1             ; 啟動 Timer 1
   23:
   24:				        ; --------------------------------------------------------------------------
   25:				        ; 2. 初始化七段顯示器 (預設全滅)
   26:				        ; --------------------------------------------------------------------------
   27:	  0041	75 A0 FF	        MOV  P2, #0FFH             ; 共陽極接法，輸出全 1 為熄滅
   28:
   29:	  0044			WAIT_CHAR:
   30:				        ; --------------------------------------------------------------------------
   31:				        ; 3. 等待並接收 Tera Term 傳送的字元
   32:				        ; --------------------------------------------------------------------------
   33:	  0044	30 98 FD	        JNB  RI, WAIT_CHAR          ; 等待接收中斷旗標 RI = 1
   34:	  0047	C2 98		        CLR  RI                  ; 清除接收旗標
   35:	  0049	E5 99		        MOV  A, SBUF            ; 讀取終端機傳入的 ASCII 字元
   36:	  004B	FF		        MOV  R7, A                    ; 將接收到的字元備份至暫存器 R7
   37:
   38:				        ; (選用) 回傳 Echo 給電腦終端機，方便在 Tera Term 上即時確認按鍵
   39:	  004C	F5 99		        MOV  SBUF, A
   40:	  004E			ECHO_WAIT:
   41:	  004E	30 99 FD	        JNB  TI, ECHO_WAIT
   42:	  0051	C2 99		        CLR  TI
   43:

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   44:				        ; --------------------------------------------------------------------------
   45:				        ; 4. 判斷輸入範圍 ('0'~'9', 'A'~'F', 'a'~'f') 並轉換為 0~15 索引值
   46:				        ; --------------------------------------------------------------------------
   47:				        ; 檢查是否小於 '0' (ASCII 30H)
   48:	  0053	EF		        MOV  A, R7
   49:	  0054	C3		        CLR  C
   50:	  0055	94 30		        SUBB        A, #'0'
   51:	  0057	40 EB		        JC    WAIT_CHAR             ; 小於 '0'，非有效輸入，忽略
   52:
   53:				        ; 檢查是否在 '0' ~ '9' 範圍內
   54:	  0059	EF		        MOV  A, R7
   55:	  005A	C3		        CLR  C
   56:	  005B	94 3A		        SUBB        A, #'9' + 1
   57:	  005D	40 1A		        JC    IS_DIGIT                ; 小於 '9'+1，表示為 '0'~'9'
   58:
   59:				        ; 檢查是否在 'A' ~ 'F' 範圍內 (ASCII 41H ~ 46H)
   60:	  005F	EF		        MOV  A, R7
   61:	  0060	C3		        CLR  C
   62:	  0061	94 41		        SUBB        A, #'A'
   63:	  0063	40 DF		        JC    WAIT_CHAR             ; 介於 '9'+1 與 'A' 之間，忽略
   64:
   65:	  0065	EF		        MOV  A, R7
   66:	  0066	C3		        CLR  C
   67:	  0067	94 47		        SUBB        A, #'F' + 1
   68:	  0069	40 14		        JC    IS_UPPER                ; 小於 'F'+1，表示為 'A'~'F'
   69:
   70:				        ; 檢查是否在 'a' ~ 'f' 範圍內 (ASCII 61H ~ 66H)
   71:	  006B	EF		        MOV  A, R7
   72:	  006C	C3		        CLR  C
   73:	  006D	94 61		        SUBB        A, #'a'
   74:	  006F	40 D3		        JC    WAIT_CHAR             ; 介於 'F'+1 與 'a' 之間，忽略
   75:
   76:	  0071	EF		        MOV  A, R7
   77:	  0072	C3		        CLR  C
   78:	  0073	94 67		        SUBB        A, #'f' + 1
   79:	  0075	40 0E		        JC    IS_LOWER                ; 小於 'f'+1，表示為 'a'~'f'
   80:
   81:	  0077	80 CB		        SJMP        WAIT_CHAR             ; 超過 'f'，忽略
   82:
   83:	  0079			IS_DIGIT:
   84:	  0079	EF		        MOV  A, R7
   85:	  007A	C3		        CLR  C
   86:	  007B	94 30		        SUBB        A, #'0'            ; A = 0 ~ 9
   87:	  007D	80 0A		        SJMP        UPDATE_LED
   88:
   89:	  007F			IS_UPPER:
   90:	  007F	EF		        MOV  A, R7
   91:	  0080	C3		        CLR  C
   92:	  0081	94 37		        SUBB        A, #('A' - 10)        ; A = 10 ~ 15
   93:	  0083	80 04		        SJMP        UPDATE_LED
   94:
   95:	  0085			IS_LOWER:
   96:	  0085	EF		        MOV  A, R7
   97:	  0086	C3		        CLR  C
   98:	  0087	94 57		        SUBB        A, #('a' - 10)        ; A = 10 ~ 15
   99:

