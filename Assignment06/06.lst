	Source File:	06.a51
	Object File:	06.hex
	List File:	06.lst



 Line  I  Addr  Code            Source

    1:				; Example program 04: 7-Segment LED scanned by Time 0
    2:				; Chin-Shiuh Shieh
    3:				; 2003-03-09
    4:				;
    5:				; Memory Allocation
    6:		N      0030	LED_DATA   		EQU		30h     ;Data Byte to be displayed
    7:		N      0000	NIBBLE  		EQU		00h     ;Bit for Nibble Control
    8:				; Pin Assignment
    9:		D      0080	LED_PORT		EQU		P0
   10:		B      00A1	HIGH_NIBBLE		EQU		P2.1
   11:		B      00A0	LOW_NIBBLE		EQU		P2.0
   12:		B      0090	BUTTON			EQU		P1.0
   13:				;
   14:		N      0000	PROG	EQU		0000h
   15:		N      0000			ORG		PROG+0000h
   16:	  0000	80 2E				SJMP	START
   17:				;Interrupt Vector Table
   18:		N      0003			ORG		PROG+0003h
   19:	  0003	12 00 46			LCALL	INT0_ISR
   20:	  0006	32				RETI
   21:		N      000B			ORG		PROG+000Bh
   22:	  000B	12 00 47			LCALL	T0_ISR
   23:	  000E	32				RETI
   24:		N      0013			ORG		PROG+0013h
   25:	  0013	12 00 81			LCALL	INT1_ISR
   26:	  0016	32				RETI
   27:		N      001B			ORG		PROG+001Bh
   28:	  001B	12 00 82			LCALL	T1_ISR
   29:	  001E	32				RETI
   30:		N      0023			ORG		PROG+0023h
   31:	  0023	12 00 83			LCALL	UART_ISR
   32:	  0026	32				RETI
   33:				;
   34:		N      0030			ORG		PROG+0030h
   35:	  0030			START:
   36:	  0030	75 30 00			MOV		LED_DATA,#00h
   37:	  0033	75 89 11	        MOV     TMOD,#00010001b	; Set Timer to work in Mode 1 (16-bit Timer)
   38:	  0036	D2 A9		        SETB	ET0				; Enable Timer 0 Interrupt
   39:	  0038	D2 AF		        SETB	EA				; Enable Interrupt
   40:	  003A	D2 8C		        SETB	TR0				; Start Timer 0
   41:	  003C			CHECK_BUTTON:
   42:	  003C	20 90 FD			JB		BUTTON,CHECK_BUTTON
   43:	  003F	05 30				INC		LED_DATA

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   44:	  0041			WAIT_BUTTON_RELEASE:
   45:	  0041	30 90 FD			JNB		BUTTON,WAIT_BUTTON_RELEASE
   46:	  0044	80 F6				SJMP	CHECK_BUTTON
   47:				;
   48:	  0046			INT0_ISR:
   49:	  0046	22				RET
   50:	  0047			T0_ISR:
   51:	  0047	75 8C FC	        MOV     TH0,#0FCh   ; Timer 0 Interrupt will be generated
   52:	  004A	75 8A 18	        MOV     TL0,#018h   ; for every 1mS
   53:	  004D	B2 00		        CPL     NIBBLE
   54:	  004F	20 00 0F	        JB      NIBBLE,SHOW_HIGH
   55:	  0052			SHOW_LOW:
   56:	  0052	D2 A1		        SETB    HIGH_NIBBLE
   57:	  0054	E5 30		        MOV     A,LED_DATA
   58:	  0056	54 0F		        ANL     A,#0Fh
   59:	  0058	90 00 71	        MOV     DPTR,#FONT
   60:	  005B	93		        MOVC    A,@A+DPTR
   61:	  005C	F5 80		        MOV     LED_PORT,A
   62:	  005E	C2 A0		        CLR     LOW_NIBBLE
   63:	  0060	22		        RET
   64:	  0061			SHOW_HIGH:
   65:	  0061	D2 A0		        SETB    LOW_NIBBLE
   66:	  0063	E5 30		        MOV     A,LED_DATA
   67:	  0065	C4		        SWAP    A
   68:	  0066	54 0F		        ANL     A,#0Fh
   69:	  0068	90 00 71	        MOV     DPTR,#FONT
   70:	  006B	93		        MOVC    A,@A+DPTR
   71:	  006C	F5 80		        MOV     LED_PORT,A
   72:	  006E	C2 A1		        CLR     HIGH_NIBBLE
   73:	  0070	22		        RET
   74:	  0071	C0 F9 A4 B0	FONT:   DB      0C0h,0F9h,0A4h,0B0h,099h,092h,082h,0F8h
	  0075	99 92 82 F8
   75:	  0079	80 90 88 83	        DB      080h,090h,088h,083h,0A7h,0A1h,086h,08Eh
	  007D	A7 A1 86 8E
   76:	  0081			INT1_ISR:
   77:	  0081	22				RET
   78:	  0082			T1_ISR:
   79:	  0082	22				RET
   80:	  0083			UART_ISR:
   81:	  0083	22				RET
   82:				;
   83:				        END





