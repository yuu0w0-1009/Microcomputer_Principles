 Line  I  Addr  Code            Source

    1:		N      0000	ORG 0000H
    2:	  0000	02 00 30	JMP MAIN
    3:
    4:		N      000B	ORG 000BH           ; Timer 0 中斷向量
    5:	  000B	02 00 48	JMP T0_ISR
    6:
    7:		N      0030	ORG 0030H
    8:	  0030			MAIN:
    9:	  0030	D2 87		    SETB P0.7       ; 初始化 DAC WR (P0.7) 為高電位
   10:	  0032	75 89 01	    MOV TMOD, #01H  ; 設定 Timer 0 為模式 1 (16位元計時器)
   11:
   12:				    ; 載入初始值 (產生約 278us 延遲)
   13:	  0035	75 8C FE	    MOV TH0, #0FEH
   14:	  0038	75 8A EA	    MOV TL0, #0EAH
   15:
   16:	  003B	90 00 61	    MOV DPTR, #SINE_TABLE
   17:	  003E	78 00		    MOV R0, #0      ; 查表索引初始化
   18:
   19:	  0040	D2 AF		    SETB EA         ; 啟用全域中斷
   20:	  0042	D2 A9		    SETB ET0        ; 啟用 Timer 0 中斷
   21:	  0044	D2 8C		    SETB TR0        ; 啟動 Timer 0
   22:
   23:	  0046			WAIT:
   24:	  0046	80 FE		    SJMP WAIT       ; 進入無窮迴圈，等待計時器中斷
   25:
   26:	  0048			T0_ISR:
   27:	  0048	C2 8C		    CLR TR0         ; 暫停計時器
   28:	  004A	75 8C FE	    MOV TH0, #0FEH  ; 重新載入計時值 (FEEAH)
   29:	  004D	75 8A EA	    MOV TL0, #0EAH
   30:	  0050	D2 8C		    SETB TR0        ; 重啟計時器
   31:
   32:	  0052	E8		    MOV A, R0
   33:	  0053	93		    MOVC A, @A+DPTR ; 從表格中取出正弦波數值
   34:	  0054	F5 90		    MOV P1, A       ; 將資料輸出至 P1 (DAC 資料埠)[cite: 2]
   35:
   36:	  0056	C2 87		    CLR P0.7        ; 將 P0.7 拉低 (觸發 DAC WR)[cite: 2]
   37:	  0058	D2 87		    SETB P0.7       ; 將 P0.7 拉高 (完成 DAC 寫入)[cite: 2]
   38:
   39:	  005A	08		    INC R0          ; 索引加 1
   40:	  005B	B8 24 02	    CJNE R0, #36, ISR_END ; 判斷是否完成一個週期 (36個取樣點)
   41:	  005E	78 00		    MOV R0, #0      ; 若達 36，將索引歸零開始下一個週期
   42:
   43:	  0060			ISR_END:

