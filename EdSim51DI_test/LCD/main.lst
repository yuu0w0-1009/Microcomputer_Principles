 Line  I  Addr  Code            Source

    1:				; 定義 LCD 控制腳位
    2:		B      0093	RS EQU P1.3
    3:		B      0092	EN EQU P1.2
    4:
    5:		N      0000	ORG 0000H
    6:	  0000	02 00 03	JMP MAIN
    7:
    8:	  0003			MAIN:
    9:				    ;初始化 LCD
   10:	  0003	12 00 17	    CALL LCD_INIT
   11:
   12:				    ;顯示字元 'L'
   13:	  0006	74 4C		    MOV A, #'L'
   14:	  0008	12 00 53	    CALL LCD_DATA
   15:
   16:				    ;顯示字元 'C'
   17:	  000B	74 43		    MOV A, #'C'
   18:	  000D	12 00 53	    CALL LCD_DATA
   19:
   20:				    ;顯示字元 'D'
   21:	  0010	74 44		    MOV A, #'D'
   22:	  0012	12 00 53	    CALL LCD_DATA
   23:
   24:	  0015			STOP:
   25:	  0015	80 FE		    SJMP STOP       ; 程式停留在此
   26:
   27:				; ==========================================
   28:				; LCD 初始化副程式 (4-bit mode)
   29:				; ==========================================
   30:	  0017			LCD_INIT:
   31:				    ; 必須先送出 0x20 將 LCD 切換到 4 位元模式
   32:	  0017	74 20		    MOV A, #20H
   33:	  0019	12 00 34	    CALL LCD_CMD_NIBBLE
   34:	  001C	12 00 75	    CALL DELAY
   35:
   36:				    ; 設定為 4-bit 模式, 2 行顯示 (N=1), 5x8 字型 (F=0) -> 指令 28H
   37:	  001F	74 28		    MOV A, #28H
   38:	  0021	12 00 3C	    CALL LCD_CMD
   39:
   40:				    ; 顯示開啟, 游標開啟, 游標閃爍關閉 -> 指令 0EH
   41:	  0024	74 0E		    MOV A, #0EH
   42:	  0026	12 00 3C	    CALL LCD_CMD
   43:

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   44:				    ; 清除顯示 -> 指令 01H
   45:	  0029	74 01		    MOV A, #01H
   46:	  002B	12 00 3C	    CALL LCD_CMD
   47:
   48:				    ; 設定進入模式 (自動遞增) -> 指令 06H
   49:	  002E	74 06		    MOV A, #06H
   50:	  0030	12 00 3C	    CALL LCD_CMD
   51:	  0033	22		    RET
   52:
   53:				; ==========================================
   54:				; 送出單一 Nibble (用於初次設定 4-bit 模式)
   55:				; ==========================================
   56:	  0034			LCD_CMD_NIBBLE:
   57:	  0034	54 F0		    ANL A, #0F0H    ; 只保留高四位元，同時將 RS (Bit 3) 設為 0
   58:	  0036	F5 90		    MOV P1, A       ; 將資料輸出至 P1
   59:	  0038	12 00 6E	    CALL PULSE_EN
   60:	  003B	22		    RET
   61:
   62:				; ==========================================
   63:				; 送出指令到 LCD (RS=0)
   64:				; ==========================================
   65:	  003C			LCD_CMD:
   66:	  003C	C0 E0		    PUSH ACC
   67:				    ; 送出高四位元
   68:	  003E	54 F0		    ANL A, #0F0H    ; 保留高四位元，清除低四位元 (RS=0)
   69:	  0040	F5 90		    MOV P1, A
   70:	  0042	12 00 6E	    CALL PULSE_EN
   71:
   72:				    ; 送出低四位元
   73:	  0045	D0 E0		    POP ACC
   74:	  0047	C4		    SWAP A          ; 上下四位元互換
   75:	  0048	54 F0		    ANL A, #0F0H    ; 保留原本的低四位元，清除低四位元 (RS=0)
   76:	  004A	F5 90		    MOV P1, A
   77:	  004C	12 00 6E	    CALL PULSE_EN
   78:
   79:	  004F	12 00 75	    CALL DELAY      ; 等待 LCD 處理指令
   80:	  0052	22		    RET
   81:
   82:				; ==========================================
   83:				; 送出資料到 LCD (RS=1)
   84:				; ==========================================
   85:	  0053			LCD_DATA:
   86:	  0053	C0 E0		    PUSH ACC
   87:				    ; 送出高四位元
   88:	  0055	54 F0		    ANL A, #0F0H    ; 保留高四位元
   89:	  0057	44 08		    ORL A, #00001000B ; 將 RS (P1.3) 設為 1 (表示傳送資料)
   90:	  0059	F5 90		    MOV P1, A
   91:	  005B	12 00 6E	    CALL PULSE_EN
   92:
   93:				    ; 送出低四位元
   94:	  005E	D0 E0		    POP ACC
   95:	  0060	C4		    SWAP A          ; 上下四位元互換
   96:	  0061	54 F0		    ANL A, #0F0H
   97:	  0063	44 08		    ORL A, #00001000B ; 將 RS (P1.3) 設為 1
   98:	  0065	F5 90		    MOV P1, A
   99:	  0067	12 00 6E	    CALL PULSE_EN

