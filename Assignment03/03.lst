	List File:	D:\code\Microcomputer_Principles\Assignment03\03.lst



 Line  I  Addr  Code            Source

    1:				;=================================================
    2:				; 功能:
    3:				; 按下 SW2 (P1.0) -> P2.0, P2.2, P2.4, P2.6 亮
    4:				; 按下 SW3 (P1.1) -> P2.1, P2.3, P2.5 亮
    5:				; 按下 SW4 (P1.2) -> 全暗
    6:				;=================================================
    7:
    8:		N      0000	        ORG     0000H       ; 程式起始位置
    9:	  0000	02 00 30	        JMP     START       ; 跳轉至主程式初始化
   10:
   11:		N      0030	        ORG     0030H       ; 主程式區塊
   12:	  0030			START:
   13:	  0030	75 A0 FF	        MOV     P2, #0FFH   ; 初始化，將所有 LED 熄滅 (輸出 1)
   14:	  0033	75 90 FF	        MOV     P1, #0FFH   ; 設定 P1 為輸入模式 (寫入 1)
   15:
   16:	  0036			MAIN_LOOP:
   17:	  0036	30 90 08	        JNB     P1.0, SW2_ON    ; 若 SW2 (P1.0) 為 0 (按下)，跳轉至 SW2 處理
   18:	  0039	30 91 10	        JNB     P1.1, SW3_ON    ; 若 SW3 (P1.1) 為 0 (按下)，跳轉至 SW3 處理
   19:	  003C	30 92 18	        JNB     P1.2, ALL_OFF   ; 若 SW4 (P1.2) 為 0 (按下)，跳轉至全暗處理
   20:	  003F	80 F5		        JMP     MAIN_LOOP       ; 持續掃描按鍵狀態
   21:
   22:	  0041			SW2_ON:
   23:	  0041	12 00 62	        CALL    DELAY           ; 呼叫防彈跳延遲
   24:	  0044	30 90 FD	        JNB     P1.0, $         ; 等待按鍵放開 (防止單次按下被重複觸發)
   25:	  0047	75 A0 AA	        MOV     P2, #0AAH       ; 輸出 10101010B (P2.0, 2.2, 2.4, 2.6 亮)
   26:	  004A	80 EA		        JMP     MAIN_LOOP       ; 回到主迴圈
   27:
   28:	  004C			SW3_ON:
   29:	  004C	12 00 62	        CALL    DELAY           ; 呼叫防彈跳延遲
   30:	  004F	30 91 FD	        JNB     P1.1, $         ; 等待按鍵放開
   31:	  0052	75 A0 D5	        MOV     P2, #0D5H       ; 輸出 11010101B (P2.1, 2.3, 2.5 亮)
   32:	  0055	80 DF		        JMP     MAIN_LOOP       ; 回到主迴圈
   33:
   34:	  0057			ALL_OFF:
   35:	  0057	12 00 62	        CALL    DELAY           ; 呼叫防彈跳延遲
   36:	  005A	30 92 FD	        JNB     P1.2, $         ; 等待按鍵放開
   37:	  005D	75 A0 FF	        MOV     P2, #0FFH       ; 輸出 11111111B (全暗)
   38:	  0060	80 D4		        JMP     MAIN_LOOP       ; 回到主迴圈
   39:
   40:				;=================================================
   41:				; 副程式: 簡單按鍵防彈跳延遲 (約 10ms - 20ms)
   42:				;=================================================
   43:	  0062			DELAY:

