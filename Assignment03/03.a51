;=================================================
; 功能: 
; 按下 SW2 (P1.0) -> P2.0, P2.2, P2.4, P2.6 亮
; 按下 SW3 (P1.1) -> P2.1, P2.3, P2.5 亮
; 按下 SW4 (P1.2) -> 全暗
;=================================================

        ORG     0000H       ; 程式起始位置
        JMP     START       ; 跳轉至主程式初始化

        ORG     0030H       ; 主程式區塊
START:
        MOV     P2, #0FFH   ; 初始化，將所有 LED 熄滅 (輸出 1)
        MOV     P1, #0FFH   ; 設定 P1 為輸入模式 (寫入 1)

MAIN_LOOP:
        JNB     P1.0, SW2_ON    ; 若 SW2 (P1.0) 為 0 (按下)，跳轉至 SW2 處理
        JNB     P1.1, SW3_ON    ; 若 SW3 (P1.1) 為 0 (按下)，跳轉至 SW3 處理
        JNB     P1.2, ALL_OFF   ; 若 SW4 (P1.2) 為 0 (按下)，跳轉至全暗處理
        JMP     MAIN_LOOP       ; 持續掃描按鍵狀態

SW2_ON:
        CALL    DELAY           ; 呼叫防彈跳延遲
        JNB     P1.0, $         ; 等待按鍵放開 (防止單次按下被重複觸發)
        MOV     P2, #0AAH       ; 輸出 10101010B (P2.0, 2.2, 2.4, 2.6 亮)
        JMP     MAIN_LOOP       ; 回到主迴圈

SW3_ON:
        CALL    DELAY           ; 呼叫防彈跳延遲
        JNB     P1.1, $         ; 等待按鍵放開
        MOV     P2, #0D5H       ; 輸出 11010101B (P2.1, 2.3, 2.5 亮)
        JMP     MAIN_LOOP       ; 回到主迴圈

ALL_OFF:
        CALL    DELAY           ; 呼叫防彈跳延遲
        JNB     P1.2, $         ; 等待按鍵放開
        MOV     P2, #0FFH       ; 輸出 11111111B (全暗)
        JMP     MAIN_LOOP       ; 回到主迴圈

;=================================================
; 副程式: 簡單按鍵防彈跳延遲 (約 10ms - 20ms)
;=================================================
DELAY:
        MOV     R6, #20
D1:     MOV     R7, #250
        DJNZ    R7, $           ; 內部小迴圈
        DJNZ    R6, D1          ; 外部大迴圈
        RET

        END                     ; 結束程式組譯