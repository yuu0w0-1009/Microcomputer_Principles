; ========================================================
; 專案名稱: 8051 雙向串列傳輸與 LED 控制
; 晶振頻率: 11.0592 MHz
; 鮑率設定: 9600 bps (Mode 1, 8-N-1)
; 功能說明: 按下 P1.0 發送訊號；接收訊號切換 P2.7 LED 狀態 (預設點亮)
; ========================================================

; 定義接腳與變數
LED_PIN     BIT P2.7        ; LED 控制接腳
BTN_PIN     BIT P1.0        ; 按鈕輸入接腳
TX_BUSY     BIT 20H.0       ; 串列傳送忙碌旗標 (內部 RAM 位元區)

; --------------------------------------------------------
; 中斷向量區
; --------------------------------------------------------
        ORG     0000H       ; 重置向量
        LJMP    START

        ORG     0023H       ; 串列埠 (UART) 中斷向量
        LJMP    UART_ISR

; --------------------------------------------------------
; 主程式起始
; --------------------------------------------------------
        ORG     0030H
START:
        MOV     SP, #5FH            ; 初始化堆疊指標

        ; 1. 初始化 I/O 接腳與狀態
        SETB    BTN_PIN             ; 將 P1.0 設為輸入模式 (準雙向埠先寫 1)
        CLR     LED_PIN             ; P2.7 輸出 0，LED 預設點亮 (低電位導通)
        CLR     TX_BUSY             ; 清除傳送忙碌旗標

        ; 2. 設定 Timer 1 產生 9600 鮑率 (晶振 11.0592MHz)
        MOV     TMOD, #20H          ; Timer 1 設定為模式 2 (8 位元自動重載)
        MOV     TH1, #0FDH          ; 鮑率 9600 對應重載值 (256 - 3 = 253 = 0FDH)
        MOV     TL1, #0FDH
        SETB    TR1                 ; 啟動 Timer 1

        ; 3. 設定串列通訊模式
        MOV     SCON, #50H          ; 模式 1 (8 位元 UART)，致能接收 (REN = 1)

        ; 4. 致能中斷
        SETB    ES                  ; 開啟串列埠中斷
        SETB    EA                  ; 開啟全域中斷

; --------------------------------------------------------
; 主迴圈：按鈕掃描與發送處理
; --------------------------------------------------------
MAIN_LOOP:
        JB      BTN_PIN, MAIN_LOOP  ; 若 P1.0 = 1 (未按下)，持續偵測
        ACALL   DELAY_20MS          ; 軟體消除彈跳
        JB      BTN_PIN, MAIN_LOOP  ; 再次確認，若為雜訊則跳回

        ; 確認按鈕按下，送出控制訊號
        SETB    TX_BUSY             ; 標記傳送中
        MOV     SBUF, #55H          ; 發送資料 (任意數值均可，此處以 0x55 為觸發代碼)
WAIT_TX:
        JB      TX_BUSY, WAIT_TX    ; 等待傳送完成中斷清除旗標

        ; 等待按鈕放開，避免重複發送
WAIT_RELEASE:
        JNB     BTN_PIN, WAIT_RELEASE ; 若 P1.0 仍為 0，持續等待放開
        ACALL   DELAY_20MS          ; 放開消除彈跳
        SJMP    MAIN_LOOP

; --------------------------------------------------------
; 串列埠中斷服務常式 (UART ISR)
; --------------------------------------------------------
UART_ISR:
        ; 檢查是否為「接收中斷」
        JNB     RI, CHECK_TI
        CLR     RI                  ; 清除接收旗標
        CPL     LED_PIN             ; 反轉 P2.7 狀態 (切換 LED 亮 / 滅)

CHECK_TI:
        ; 檢查是否為「傳送中斷」
        JNB     TI, EXIT_ISR
        CLR     TI                  ; 清除傳送旗標
        CLR     TX_BUSY             ; 清除忙碌旗標，通知主迴圈傳送完成

EXIT_ISR:
        RETI

; --------------------------------------------------------
; 延遲子程式 (約 20 ms @ 11.0592 MHz)
; --------------------------------------------------------
DELAY_20MS:
        MOV     R6, #40
D1:
        MOV     R7, #250
D2:
        DJNZ    R7, D2
        DJNZ    R6, D1
        RET

        END