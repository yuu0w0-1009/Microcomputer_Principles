 Line  I  Addr  Code            Source

    1:				; Example Program 03: External Counter
    2:				; Chin-Shiuh Shieh
    3:				; 2003-03-08
    4:				;
    5:				; Pin Assignment
    6:		D      00A0	LED_PORT	EQU		P2
    7:				;
    8:		N      0000	PROG	EQU		0000h
    9:		N      0000			ORG		PROG+0000h
   10:	  0000	02 00 30			JMP		START
   11:				;Interrupt Vector Table
   12:		N      0003			ORG		PROG+0003h
   13:	  0003	12 00 42			LCALL	INT0_ISR
   14:	  0006	32				RETI
   15:		N      000B			ORG		PROG+000Bh
   16:	  000B	12 00 43			LCALL	T0_ISR
   17:	  000E	32				RETI
   18:		N      0013			ORG		PROG+0013h
   19:	  0013	12 00 44			LCALL	INT1_ISR
   20:	  0016	32				RETI
   21:		N      001B			ORG		PROG+001Bh
   22:	  001B	12 00 45			LCALL	T1_ISR
   23:	  001E	32				RETI
   24:		N      0023			ORG		PROG+0023h
   25:	  0023	12 00 46			LCALL	UART_ISR
   26:	  0026	32				RETI
   27:				;
   28:		N      0030			ORG		PROG+0030h
   29:	  0030	75 8C 00	START:	MOV		TH0,#00h
   30:	  0033	75 8A 00			MOV		TL0,#00h
   31:	  0036	75 89 05			MOV		TMOD,#00000101b	; Set Timer/Counter 0 to be 16-bit External Counter
   32:	  0039	D2 8C				SETB	TR0				; Turn on Counter 0
   33:	  003B	E5 8A		LOOP:	MOV		A,TL0
   34:	  003D	F4				CPL		A
   35:	  003E	F5 A0				MOV		LED_PORT,A
   36:	  0040	80 F9				SJMP	LOOP
   37:				;
   38:	  0042			INT0_ISR:
   39:	  0042	22				RET
   40:	  0043			T0_ISR:
   41:	  0043	22				RET
   42:	  0044			INT1_ISR:
   43:	  0044	22				RET

